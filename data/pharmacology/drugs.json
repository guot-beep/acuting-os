      "drugtarget_id": "drugtarget.nkcc2",
      "rxnorm_rxcui": "4603",
      "mechanism_en": "Prevents reabsorption of sodium and chloride in the loop of Henle, enhancing diuresis.",
      "mechanism_zh": "阻止亨利氏環對鈉與氯的再吸收,增強利尿。",
      "site_of_action_en": "Thick ascending limb of the loop of Henle",
      "site_of_action_zh": "亨利氏環粗上行支",
      "physiologic_effect_en": "Very efficient and fast-acting diuresis",
      "physiologic_effect_zh": "利尿作用強且快",
      "indications_en": [
        "Edema associated with chronic heart failure",
        "Liver cirrhosis",
        "Renal disease"
      ],
      "indications_zh": [
        "慢性心衰竭相關水腫",
        "肝硬化",
        "腎臟疾病"
      ],
      "boxed_warning_en": "Furosemide tablets are a potent diuretic which, if given in excessive amounts, can lead to a profound diuresis with water and electrolyte depletion. Therefore, careful medical supervision is required and dose and dose schedule must be adjusted to the individual patient needs.",
