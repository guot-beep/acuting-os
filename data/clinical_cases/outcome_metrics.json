      "name": "pain_score",
      "label_zh": "疼痛(0 無痛 / 10 最痛)",
      "label_en": "Pain score (0 none / 10 worst)",
      "category": "symptom",
      "unit": "0-10",
      "direction_good": "decrease"
    },
    {
