    },
    {
      "id": "not_self_treatment_en",
      "language": "en",
      "text": "Not for self-treatment; use only under professional supervision.",
      "expected": "cautions",
      "expected_direction_id": "professional_supervision_required"
    }
  ],
  "canonical_write_gate": {
    "all_required": [
      "controlled_direction_recognized",
      "source_ref_present",
      "source_locator_supports_direction",
      "valid_source_level",
      "subject_scope_matches_source_level",
      "bilingual_parity_or_single_language_only",
      "no_unresolved_canonical_relation"
    ],
    "fail_action": "keep in research staging / needs_review; do not write canonical safety fields"
  },
  "regulatory_nonclinical_context_patterns": {
    "en": [
      "anti-doping",
