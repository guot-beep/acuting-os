      "expected_direction_id": "exposure_limit_prohibited",
      "expected_target_scope": "exposure > stated limit"
    },
    {
      "id": "regulatory_prohibited_en",
      "language": "en",
      "text": "Prohibited in competition under the applicable anti-doping rule.",
