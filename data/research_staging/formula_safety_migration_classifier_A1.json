    },
    {
      "id": "ambiguous_avoid_zh",
      "language": "zh",
      "text": "孕期應避免使用。",
      "expected": "needs_review",
      "expected_review_reason": "ambiguous_avoidance"
    },
    {
      "id": "mixed_en",
      "language": "en",
