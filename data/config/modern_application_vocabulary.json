{
  "vocabulary_version": "1.0",
  "created_at": "2026-07-22",
  "name_zh": "現代運用詞彙",
  "name_en": "Modern application vocabulary",
  "purpose": "Raw snake_case keys were rendering straight into the UI (common_cold, uri, chills_body_ache_context). Those are internal identifiers, not content. This maps every tag to a bilingual label and a TYPE, so the card can show 感冒 Common cold and route each tag to the right section.",
  "type_note": {
    "condition": "a real modern diagnosis - links to the condition canon",
    "symptom": "a symptom or finding, not a diagnosis",
    "pattern": "a TCM pattern that was mis-filed under modern application - render under patterns, not here",
    "internal": "workflow state that must NEVER render as a clinical tag"
  },
  "id_policy": "Source tag strings are NOT renamed - DECISIONS D1 keeps ids immutable. Variants such as cough and cough_context both resolve here via aliases, which also collapses the ~18 duplicate pairs.",
  "review_status": "draft",
