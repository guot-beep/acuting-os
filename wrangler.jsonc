// Cloudflare deploy config for AcuTing OS(private clinical app)。
  // 靜態資產:dist/(scripts/build-site.js 只複製 index.html 引用的檔案,並擋 curriculum// clinical// imports// docs/)。
  // 病例服務:src/worker.mjs 只攔 /__clinical/*(run_worker_first),其餘交給資產;病例正本在 D1(D33)。
  // 認證:每一條 /__clinical/* 都驗 Cloudflare Access 的 JWT(vars 三個 ACCESS_*);沒設 → 503 fail-closed。
  // 這個檔由 scripts/apply-d1-production-config.js 產生;改值請改那支的參數再跑一次,並讓 validate-d1-deploy-gate.js 過。
{
  "name": "acuting-os",
  "compatibility_date": "2026-07-26",
  "build": {
    "command": "node scripts/build-site.js"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/__clinical/*"
    ]
  },
  "main": "src/worker.mjs",
  "d1_databases": [
    {
      "binding": "CLINICAL_DB",
      "database_name": "acuting-clinical",
      "database_id": "c96bd14b-70ed-49c1-8abf-1eeb1eac651f"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "CLINICAL_DB_NAME": "acuting-clinical",
    "ACCESS_TEAM_DOMAIN": "https://soft-snow-1c0c.cloudflareaccess.com",
    "ACCESS_AUD": "a2d8e3c1923f65e2088fb86186f440979022197a6731cbb072e0a432c64dd935",
    "ACCESS_ALLOWED_EMAILS": "guotingru@gmail.com"
  }
}
