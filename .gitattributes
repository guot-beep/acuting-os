# Store and check out text files with LF everywhere, so Windows CRLF never
# shows up as phantom "local changes" or merge conflicts again.
* text=auto eol=lf

# Windows scripts must keep CRLF or cmd.exe can misparse them.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets: never touch line endings
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.woff binary
*.woff2 binary
